{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    // "moduleResolution": "Node",
    "rootDir": "./src",
    "outDir": "deploy/dist",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true
  },

  "include": ["src/**/*"],

  "exclude": ["node_modules"]
}
